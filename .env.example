# Upstream AutoAPI API (FastAPI). Include the versioned prefix.
AUTOAPI_API_URL=http://localhost:8000/api/v1

# NextAuth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEXTAUTH_SECRET=change-me-to-at-least-32-random-characters
NEXTAUTH_URL=http://localhost:3000

# Public origin of this app, used for billing return URLs and CSRF origin checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
